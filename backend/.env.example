# Ambiente
APP_ENV=development
DEBUG=true
SECRET_KEY=TROQUE_ESSA_CHAVE_POR_UMA_SEGURA_32_CHARS
ENCRYPTION_KEY=  # Será gerado automaticamente no primeiro boot

# Banco de dados
# Local (SQLite):
# DATABASE_URL=sqlite:///./ifnmg_assistente.db
#
# Produção (Supabase PostgreSQL):
# Use o POOLER do Supabase (IPv4), NÃO o "Direct connection" (db.<ref>.supabase.co é IPv6-only).
# - Pooler de sessão (recomendado p/ FastAPI+SQLAlchemy): porta 5432
# - Pooler de transação (serverless): porta 6543
# Formato: postgresql+psycopg://postgres.<PROJECT_REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require

# CORS (separar por vírgula). Domínios *.vercel.app também são aceitos automaticamente
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# IA (Padrão gratuito - Google Gemini)
DEFAULT_AI_PROVIDER=groq
GROQ_API_KEY=  # Obtenha grátis em https://console.groq.com/

# Opcionais (aluno pode adicionar a própria chave)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Web Push (gere com: python -m py_vapid --gen)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@ifnmg-assistente.app

# Redis (opcional, para cache)
REDIS_URL=redis://localhost:6379

# Telegram Bot (opcional)
TELEGRAM_BOT_TOKEN=
