# Ambiente
APP_ENV=development
DEBUG=true
SECRET_KEY=  # Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=  # Gere com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Banco de dados (OBRIGATÓRIO - use PostgreSQL em produção)
# Local (SQLite - apenas desenvolvimento):
# DATABASE_URL=sqlite:///./ifnmg_assistente.db
#
# Produção (PostgreSQL - Supabase, Neon, Cloud SQL, etc.):
# Formato: postgresql+psycopg://usuario:senha@host:porta/dbname?sslmode=require
DATABASE_URL=

# CORS (separar por vírgula). Domínios *.vercel.app também são aceitos via regex
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# IA (Padrão gratuito - Groq)
DEFAULT_AI_PROVIDER=groq
GROQ_API_KEY=  # Obtenha grátis em https://console.groq.com/

# Opcionais (aluno pode adicionar a própria chave via UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Web Push (gere com: python -m py_vapid --gen)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@ifnmg-assistente.app

# Redis (opcional, para cache/rate limit distribuído)
REDIS_URL=redis://localhost:6379

# Telegram Bot (opcional)
TELEGRAM_BOT_TOKEN=

# Moodle
MOODLE_BASE_URL=https://virtual2.ifnmg.edu.br
SCRAPER_INTERVAL_MINUTES=30

# Segurança
BCRYPT_ROUNDS=12
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SYNC_PER_HOUR=10